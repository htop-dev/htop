# Beware! This file is rewritten by htop when settings are changed in the interface.
# The parser is also very primitive, and not human-friendly.
# Configuration for the macOS CI smoke tests; it deliberately exercises the
# M_FOOTPRINT column (phys_footprint via proc_pid_rusage, cf. issue #2132).
htop_version=3.5.3
config_reader_min_version=3
hide_kernel_threads=1
hide_userland_threads=1
shadow_other_users=0
show_program_path=1
highlight_base_name=0
highlight_megabytes=1
highlight_threads=1
tree_view=0
sort_key=46
tree_sort_key=0
sort_direction=-1
tree_sort_direction=1
delay=15
header_layout=two_50_50
column_meters_0=CPU Memory Swap
column_meter_modes_0=1 1 1
column_meters_1=Tasks LoadAverage Uptime
column_meter_modes_1=2 2 2
screen:Main=PID USER PRIORITY NICE M_VIRT M_RESIDENT M_FOOTPRINT STATE PERCENT_CPU PERCENT_MEM TIME Command
.sort_key=M_FOOTPRINT
.tree_sort_key=PID
.tree_view_always_by_pid=0
.tree_view=0
.sort_direction=-1
.tree_sort_direction=1
.all_branches_collapsed=0
screen:I/O=PID USER IO_RATE IO_READ_RATE IO_WRITE_RATE RBYTES WBYTES Command
.sort_key=IO_RATE
.tree_sort_key=PID
.tree_view_always_by_pid=0
.tree_view=0
.sort_direction=-1
.tree_sort_direction=1
.all_branches_collapsed=0
